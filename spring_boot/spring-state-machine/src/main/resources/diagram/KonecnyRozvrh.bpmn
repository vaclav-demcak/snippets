634A68FEF1D</bpmn:incoming><bpmn:outgoing>EAID_AF99D8A0_6B6A_4d2c_8869_D197729578E0</bpmn:outgoing></bpmn:userTask><bpmn:sequenceFlow id="EAID_AF99D8A0_6B6A_4d2c_8869_D197729578E0" sourceRef="EAID_C6E32FF7_8E39_42ee_87DD_CF02B06FE7A6" targetRef="EAID_C9FA98D3_02AB_4ba1_9FD7_D8633B8C1BCF"/><bpmn:dataObjectReference id="EAID_8986F296_420D_4592_ACF5_4E76C096CAE7" name="Podanie s el. podpisom" dataObjectRef="EAID_DOb000000_420D_4592_ACF5_4E76C096CAE7"/><bpmn:dataObject id="EAID_DOb000000_420D_4592_ACF5_4E76C096CAE7" name="Podanie s el. podpisom" isCollection="false"/><bpmn:startEvent id="EAID_9596A169_56CE_4160_B6F5_F6102270560E" isInterrupting="true" parallelMultiple="false"><bpmn:outgoing>EAID_0685E08B_6803_4543_9D24_6634A68FEF1D</bpmn:outgoing></bpmn:startEvent><bpmn:sequenceFlow id="EAID_0685E08B_6803_4543_9D24_6634A68FEF1D" sourceRef="EAID_9596A169_56CE_4160_B6F5_F6102270560E" targetRef="EAID_C6E32FF7_8E39_42ee_87DD_CF02B06FE7A6"/><bpmn:association id="EAID_A904601C_1761_414c_9A18_AC6AA29A235D" sourceRef="EAID_F3DF6FCA_4791_499b_8B1A_10BABA774D8E" targetRef="EAID_C6E32FF7_8E39_42ee_87DD_CF02B06FE7A6" associationDirection="None"/></bpmn:process><bpmn:globalManualTask id="EAID_DD8311F5_9C05_4d1e_8186_DB38B2088C72" name="Odmietnutie návrhu"/><bpmn:process id="EAID_F21A13F7_5760_44d2_B000_A594E61D4E69" name="BP-K-19 Podanie návrhu na pristúpenie do konania" isClosed="false" processType="None"><bpmn:documentation textFormat="text/html">Proces je namodelovan&amp;#253; v zmysle &amp;#167; 24 ods.2 Z&amp;#225;kona &#x10D;. 7/2005 o konkurze a reštrukturaliz&amp;#225;cii.&#xD;
 Verite&#x13E; pod&amp;#225;va n&amp;#225;vrh na prist&amp;#250;penie v zmysle &amp;#167;24 ods. 2 prostredn&amp;#237;ctvom elektronick&amp;#233;ho formul&amp;#225;ra v syst&amp;#233;me REPLIK, ktor&amp;#253; sa n&amp;#225;sledne zasiela do elektronickej schr&amp;#225;nky s&amp;#250;du. Tak&amp;#233;to podanie m&amp;#244;že verite&#x13E; vykona&#x165; až do vydania uznesenia o vyhl&amp;#225;sen&amp;#237; konkurzu. O prist&amp;#250;pen&amp;#237; do konkurzn&amp;#233;ho konania rozhodne s&amp;#250;d do 15 dn&amp;#237; od doru&#x10D;enia n&amp;#225;vrhu uznesen&amp;#237;m na n&amp;#225;vrh verite&#x13E;a, ktor&amp;#253; m&amp;#225; do konkurzn&amp;#233;ho konania prist&amp;#250;pi&#x165;.&#xD;
N&amp;#225;sledne po prijat&amp;#237; uznesenia do IS REPLIK syst&amp;#233;m vykon&amp;#225; spracovanie &amp;#250;dajov a zmenu v zozname verite&#x13E;ov.</bpmn:documentation><bpmn:ioSpecification><bpmn:dataOutput id="EAID_A01B1026_19FB_4d5b_8ECC_973601B5A30F" name="Uznesenie o pristúpení do konania" isCollection="false"/><bpmn:inputSet/><bpmn:outputSet><bpmn:dataOutputRefs>EAID_A01B1026_19FB_4d5b_8ECC_973601B5A30F</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:laneSet id="EAID_LS000000_5760_44d2_B000_A594E61D4E69"><bpmn:lane id="EAID_754B78D8_C126_4277_915E_A9AD7D9BDC9B" name="Verite&#x13E;"><bpmn:flowNodeRef>EAID_16BE2B27_E573_46d2_8517_3FF81F0BE4DB</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_7E301185_186D_499e_9DFD_E352B3DBFD1A</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_A4EA3869_9864_4ba3_BA75_7630D8449956</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="EAID_B40C437C_C928_4cdf_94F8_C6F62F5288A4" name="Systém"><bpmn:flowNodeRef>EAID_0CA62D8B_B31D_45d1_AC01_57B03522B04C</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_ABDBF9A9_F49F_49ad_BC55_A30A3F0F31AA</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_1B649A1F_2D97_482a_ACFF_E702EBB914F9</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_D6CEE372_9711_479a_8AAE_623B4072198D</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_8042E1A3_8479_4986_9415_29AE5EED548B</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="EAID_4749524B_C232_4403_A54B_0C0CEA73E55B" name="Sudca"><bpmn:flowNodeRef>EAID_9B6CDD5C_52B1_4dab_AA47_697F8271701C</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_7C78A8EE_8A48_434c_85E3_EC623444BBA9</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_360B1F52_42E8_4e5f_A3F8_F61D55207D55</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_A33CB226_4D1D_4c6e_B58F_F7365476E585</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_0B33487D_B64A_4e29_BEB5_D926CC557E6A</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_B96F5300_03C0_4440_9E91_091BA60D6DD2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:endEvent id="EAID_9B6CDD5C_52B1_4dab_AA47_697F8271701C"><bpmn:incoming>EAID_4280D5A0_2C
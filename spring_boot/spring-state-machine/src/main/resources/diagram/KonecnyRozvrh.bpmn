f></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:sequenceFlow id="EAID_CDCF4055_EC09_4e62_8148_F2AC2ECA73B4" sourceRef="EAID_87E6F954_A0C4_4786_B69F_0189AE449C73" targetRef="EAID_29AC9B04_E6DD_4b7d_9D07_5706385950BE"/><bpmn:endEvent id="EAID_E676EBF1_CB9A_4068_9DAB_3048CC840F2D" name="Zastavenie konania"><bpmn:incoming>EAID_89DFF944_32E8_4aa7_828C_1C58DA6F56D5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="EAID_89DFF944_32E8_4aa7_828C_1C58DA6F56D5" sourceRef="EAID_29AC9B04_E6DD_4b7d_9D07_5706385950BE" targetRef="EAID_E676EBF1_CB9A_4068_9DAB_3048CC840F2D"/></bpmn:process><bpmn:process id="EAID_BBBBF0E9_2374_4279_91EF_AB40A8A62C77" name="BP-K-08 Poh&#x13E;adávky" isClosed="false" processType="None"><bpmn:documentation textFormat="text/html">Všetky &amp;#167; uveden&amp;#233;ho textu s&amp;#250; uveden&amp;#233; v z&amp;#225;kone &#x10D;. 7/2005 o konkurze a reštrukturaliz&amp;#225;cii, ak nie je uveden&amp;#233; inak.&#xD;
IS REPLIK  spracuje, zaeviduje, zverejn&amp;#237; alebo vymaže s notifik&amp;#225;ciou o negat&amp;#237;vnom rozhodnut&amp;#237; pod&#x13E;a pr&amp;#237;slušn&amp;#253;ch &amp;#167;&#xD;
Životn&amp;#253; cyklus poh&#x13E;ad&amp;#225;vok prebieha podla &amp;#167; 94-101&#xD;
&#xD;
Proces zah&#x155;&#x148;a &#xD;
&lt;ol&gt;&#xD;
	&lt;li&gt;BP-PHL-01 Prihlasovanie poh&#x13E;ad&amp;#225;vok&lt;/li&gt;&#xD;
	&lt;li&gt;BP-PHL-02 Spr&amp;#225;va položky zoznamu poh&#x13E;ad&amp;#225;vok&lt;/li&gt;&#xD;

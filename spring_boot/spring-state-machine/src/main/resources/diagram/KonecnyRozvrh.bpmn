IS REPLIK po prijat&amp;#237; uznesenia o ustanoven&amp;#237; predbežn&amp;#233;ho spr&amp;#225;vcu vykon&amp;#225; spracovanie &amp;#250;dajov a priradenie pr&amp;#237;stupu ustanoven&amp;#233;mu spr&amp;#225;vcovi. Predbežn&amp;#253; spr&amp;#225;vca v zmysle &amp;#167;21 vykon&amp;#225;va predbežn&amp;#233; zis&#x165;ovanie majetku dlžn&amp;#237;ka zasiela s&amp;#250;du z&amp;#225;vere&#x10D;n&amp;#250; spr&amp;#225;vu o majetnosti alebo nemajetnosti dlžn&amp;#237;ka. &#xD;
Na z&amp;#225;klade zistenia predbežn&amp;#233;ho spr&amp;#225;vcu m&amp;#244;že nasledova&#x165; proces Vyhl&amp;#225;senia konkurzu, alebo pri nedostatku majetku proces Zastavenia konkurzn&amp;#233;ho konania.</bpmn:documentation><bpmn:ioSpecification><bpmn:dataOutput id="EAID_5422E3FD_B15F_4bf8_91E8_81543EA00129" name="Závere&#x10D;ná správa o nemajetnosti/majetnosti dlžníka" isCollection="false"/><bpmn:inputSet/><bpmn:outputSet><bpmn:dataOutputRefs>EAID_5422E3FD_B15F_4bf8_91E8_81543EA00129</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:laneSet id="EAID_LS000000_64D5_4113_A54E_D9BE7ABD6DB1"><bpmn:lane id="EAID_0002B4A2_0768_42af_AA00_70D05AE8C7B7" name="Správca"><bpmn:flowNodeRef>EAID_67CB2248_4DFC_40d7_95A1_96D71E001710</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_0C6EF857_DC14_4d1b_B389_E93D06283678</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_5A2B3513_AFA0_4f98_A843_F10E63C87780</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_43221B8B_100E_412e_A77E_076543916BE8</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_944DE29F_1B03_4b49_9210_EBFC8731CAF3</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_22D1C614_FD0A_4af7_A361_71361C8B5392</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_E2CDDC3A_87C5_4b03_9AF4_844404B68600</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_9E23CA45_6E8C_436f_85A4_A51CF81B30E8</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_2A747430_42F3_4640_B020_C984633B0CF1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="EAID_DBA64B83_444D_4026_9B7E_2F68F2AB540F" name="Sudca"/></bpmn:laneSet><bpmn:intermediateCatchEvent id="EAID_67CB2248_4DFC_40d7_95A1_96D71E001710" name="Do 45 dní od ustanovenia" parallelMultiple="false"><bpmn:incoming>EAID_927E9431_7851_48f6_BA30_34CA902D4BA6</bpmn:incoming><bpmn:outgoing>EAID_4200F212_727F_4199_9594_8D2B74E58EA0</bpmn:outgoing><bpmn:outgoing>EAID_B0167376_A423_448e_9509_1D9E828A37F2</bpmn:outgoing><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent><bpmn:userTask id="EAID_0C6EF857_DC14_4d1b_B389_E93D06283678" name="Vytvorenie závere&#x10D;nej sp
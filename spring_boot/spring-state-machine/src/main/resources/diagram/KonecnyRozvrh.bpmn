4_18C6_4c6b_89FC_136D74D582CA" sourceRef="EAID_E1B7295D_6796_4327_A89B_80EEC3C69062" targetRef="EAID_7E6B7856_6E52_4cf0_A6FE_12FE33205B91"/><bpmn:messageFlow id="EAID_0F9E2C62_5CEC_4cf1_B31E_BE06B282E6CC" sourceRef="EAID_E1B7295D_6796_4327_A89B_80EEC3C69062" targetRef="EAID_805A284A_B602_49b0_8ECF_5EA5884C486B"/><bpmn:messageFlow id="EAID_24ED301D_806D_46e8_BCF7_06FD7D334BCE" name="Uznesenie o nepovolení (dostupné iba pre ú&#x10D;astníkov konania)" sourceRef="EAID_C04D676B_D1E1_4553_8B49_7C1132F6528E" targetRef="EAID_D576F7A2_D062_470b_86AC_5B55A77A933C"/><bpmn:messageFlow id="EAID_F5A2FFC4_3E06_4e83_BB1B_9801C14F09BE" sourceRef="EAID_997BD8C8_8FB1_488e_8F2F_730343C77F5A" targetRef="EAID_C794204E_CC72_41c1_8706_E0F5D06CC65C"/><bpmn:messageFlow id="EAID_F251D4A0_BD87_49e0_ACD9_3D3161E848AA" sourceRef="EAID_A58B876C_D18B_4aa2_B8F0_49C15AD17F6F" targetRef="EAID_8EA2FC3B_8868_4c99_8216_599376630E6B"/></bpmn:collaboration><bpmn:process id="EAID_BED3970A_FEC2_4e5a_9875_DC5514DA14B6" name="BP-K-01 Podanie návrhu na vyhlásenie konkurzu - likvidátor" isClosed="false" processType="None"><bpmn:documentation textFormat="text/html">Proces je namodelovan&amp;#253; v zmysle &amp;#167; 11-13 Z&amp;#225;kona &#x10D;. 7/2005 o konkurze a reštrukturaliz&amp;#225;cii.&#xD;
N&amp;#225;vrh na vyhl&amp;#225;senie konkurzu pod&amp;#225;va verite&#x13E; v syst&amp;#233;me REPLIK v elektronickej podobe prostredn&amp;#237;ctvom elektronick&amp;#233;ho formul&amp;#225;ra do elektronickej schr&amp;#225;nky s&amp;#250;du. N&amp;#225;vrh mus&amp;#237; by&#x165; autorizovan&amp;#253; pod&amp;#225;vate&#x13E;om a s&amp;#250;&#x10D;as&#x165;ou podania s&amp;#250; pr&amp;#237;lohy definovan&amp;#233; &amp;#167; 12.&#xD;
S&amp;#250;d n&amp;#225;sledne rozhoduje o n&amp;#225;vrhu a zasiela do syst&amp;#233;mu REPLIK vyjadrenie k n&amp;#225;vrhu.&#xD;
- V&amp;#253;zva na odstr&amp;#225;nenie nedostatkov v pr&amp;#237;pade, ak n&amp;#225;vrh obsahuje nedostatky. V takomto pr&amp;#237;pade verite&#x13E; n&amp;#225;vrh uprav&amp;#237; a proces sa znovu opakuje.&#xD;
- Uznesenie o za&#x10D;at&amp;#237; konkurzn&amp;#233;ho konania v pr&amp;#237;pade, ak s&amp;#250;d schv&amp;#225;lil n&amp;#225;vrh. Syst&amp;#233;m REPLIK uznesenie spracuje a zverejn&amp;#237;.&#xD;
Uznesenie o odmietnut&amp;#237; n&amp;#225;vrhu sa v syst&amp;#233;me REPLIK nezverej&#x148;uje.&#xD;
&#xD;
&#xD;

n:serviceTask id="EAID_2A747430_42F3_4640_B020_C984633B0CF1" name="Spracovanie uznesenia a priradenie predbežného správcu" startQuantity="1" completionQuantity="1" isForCompensation="false" implementation="##unspecified"><bpmn:incoming>EAID_27AD470F_078F_4a2d_A1D4_157D5F672F6E</bpmn:incoming><bpmn:outgoing>EAID_5A5BA267_A15C_4223_A712_C490BDBAAF6E</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="EAID_5A5BA267_A15C_4223_A712_C490BDBAAF6E" sourceRef="EAID_2A747430_42F3_4640_B020_C984633B0CF1" targetRef="EAID_22D1C614_FD0A_4af7_A361_71361C8B5392"/><bpmn:sequenceFlow id="EAID_27AD470F_078F_4a2d_A1D4_157D5F672F6E" sourceRef="EAID_9E23CA45_6E8C_436f_85A4_A51CF81B30E8" targetRef="EAID_2A747430_42F3_4640_B020_C984633B0CF1"/></bpmn:process><bpmn:process id="EAID_E070B000_37B5_447d_8248_87BF110F892C" name="BP-K-18 Podanie návrhu na vstup do konania - prevod/prechod poh&#x13E;adávky" isClosed="false" processType="None"><bpmn:documentation textFormat="text/html">Všetky &amp;#167; uveden&amp;#233;ho textu s&amp;#250; uveden&amp;#233; v z&amp;#225;kone &#x10D;. 7/2005 o konkurze a reštrukturaliz&amp;#225;cii, ak nie je uveden&amp;#233; inak.&#xD;
IS REPLIK  spracuje, zaeviduje, zverejn&amp;#237; alebo vymaže s notifik&amp;#225;ciou o negat&amp;#237;vnom rozhodnut&amp;#237; pod&#x13E;a pr&amp;#237;slušn&amp;#253;ch &amp;#167;&#xD;
Vstup do konania je namodelovan&amp;#253; pod&#x13E;a &amp;#167; 25. IS REPLIK umož&#x148;uje verite&#x13E;ovi poda&#x165; n&amp;#225;vrh na vstup do konania prevodom alebo prechodom poh&#x13E;ad&amp;#225;vky prostredn&amp;#237;ctvom el. formul&amp;#225;ra. Spr&amp;#225;vca n&amp;#225;sledne spracuje n&amp;#225;vrh a odošle na s&amp;#250;d, ktor&amp;#253; rozhodne a n&amp;#225;sledne IS REPLIK zaeviduje zmenu v zozname verite&#x13E;ov a poh&#x13E;ad&amp;#225;vok. </bpmn:documentation><bpmn:ioSpecification><bpmn:dataInput id="EAID_0396D3CF_2D05_40be_87EB_EF183ED440C0" name="Listiny, ktoré osved&#x10D;ujú dôvod vstupu nadobúdate&#x13E;a poh&#x13E;adávky do konkurzného konania" isCollection="false"/><bpmn:dataInput id="EAID_AC8498F6_D96C_40ae_8E12_80B303311F92" name="Identifikátor poh&#x13E;adávky" isCollection="false"/><bpmn:dataOutput id="EAID_735263FC_75B1_4c82_BF5D_BE93F976877D" name="Uznesenie o vstupe do konania" isCollection="false"/><bpmn:inputSet><bpmn:dataInputRefs>EAID_0396D3CF_2D05_40be_87EB_EF183ED440C0</bpmn:dataInputRefs><bpmn:dataInputRefs>EAID_AC8498F6_D96C_40ae_8E12_80B303311F92</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet><bpmn:dataOutputRefs>EAID_735263FC_75B1_4c82_BF5D_BE93F976877D</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:laneSet id="EAID_LS000000_37B5_447d_8248_87BF110F892C"><bpmn:lane id="EAID_ACD3F065_ED84_46ab_AD4F_8B69F67F8F87" name="Verite&#x13E;"><bpmn:flowNodeRef>EAID_C748EEB5_C584_4a05_B9C9_B73C557A884A</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_C6E32FF7_8E39_42ee_87DD_CF02B06FE7A6</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_9596A169_56CE_4160_B6F5_F6102270560E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="EAID_97268C1D_5C47_451a_A807_66832F57D23F" name="Správca"><bpmn:flowNodeRef>EAID_0896B7EE_3C62_4f2f_A97E_9D5CADE231E7</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_D8BA094A_A544_42fb_BA68_A363D30307C8</bpmn:flowNodeRef><bpmn:flowNodeRef>EAID_146940FA_68F8_4329_B060_EF3B7EE845C8</bpmn:flowNodeRef><bpmn:flowNodeRef>EA